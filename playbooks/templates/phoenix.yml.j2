apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: phoenix-data
  namespace: {{ openshift_vm_namespace }}
  labels:
    app.kubernetes.io/part-of: rhel-gitops
spec:
  accessModes: [ReadWriteOnce]
{% if phoenix_storage_class | length > 0 %}
  storageClassName: {{ phoenix_storage_class }}
{% endif %}
  resources:
    requests:
      storage: {{ phoenix_storage_size }}
---
apiVersion: v1
kind: Service
metadata:
  name: phoenix
  namespace: {{ openshift_vm_namespace }}
  labels:
    app.kubernetes.io/part-of: rhel-gitops
spec:
  type: ClusterIP
  selector:
    app: rhel-gitops-phoenix
  ports:
    - name: http
      port: 6006
      targetPort: http
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: phoenix
  namespace: {{ openshift_vm_namespace }}
  labels:
    app.kubernetes.io/part-of: rhel-gitops
spec:
  replicas: 1
  # Avoid concurrent SQLite writers and RWO mount conflicts during upgrades.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: rhel-gitops-phoenix
  template:
    metadata:
      labels:
        app: rhel-gitops-phoenix
    spec:
      automountServiceAccountToken: false
      # A Service named phoenix otherwise injects PHOENIX_PORT=tcp://..., which
      # collides with Phoenix's integer-valued application setting.
      enableServiceLinks: false
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: phoenix
          image: {{ phoenix_image }}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          env:
            - name: PHOENIX_WORKING_DIR
              value: /data
            - name: HOME
              value: /tmp
            - name: PHOENIX_HOST
              value: 0.0.0.0
            - name: PHOENIX_PORT
              value: "6006"
            # No public Route/Ingress: use Telepresence or a local port-forward.
            - name: PHOENIX_ENABLE_AUTH
              value: "false"
            - name: PHOENIX_TELEMETRY_ENABLED
              value: "false"
            - name: PHOENIX_ALLOW_EXTERNAL_RESOURCES
              value: "false"
            - name: PHOENIX_ENABLE_MCP_SERVER
              value: "false"
          ports:
            - name: http
              containerPort: 6006
          readinessProbe:
            httpGet:
              path: /healthz
              port: http
            initialDelaySeconds: 5
            periodSeconds: 5
          startupProbe:
            httpGet:
              path: /healthz
              port: http
            failureThreshold: 60
            periodSeconds: 5
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: "1"
              memory: 1Gi
          volumeMounts:
            - name: data
              mountPath: /data
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: phoenix-data
        - name: tmp
          emptyDir: {}
