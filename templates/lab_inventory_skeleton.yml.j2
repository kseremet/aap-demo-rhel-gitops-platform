---
# Skeleton populated by playbooks/setup/03_discover_inventory.yml.
# Management addresses are platform facts, not RHEL desired state.
all:
  hosts:
    localhost:
      ansible_connection: local
      ansible_python_interpreter: "{{ ansible_playbook_python }}"
  children:
    rhel_fleet:
      vars:
        ansible_user: cloud-user
        ansible_become: true
        ansible_ssh_common_args: "-o StrictHostKeyChecking=no"
      children:
        web_servers:
          hosts: {}
        database_servers:
          hosts: {}
        app_servers:
          hosts: {}
