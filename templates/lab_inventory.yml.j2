---
# Generated by playbooks/setup/03_discover_inventory.yml.
# Management addresses are platform facts, not RHEL desired state.
all:
  children:
    rhel_fleet:
      vars:
        ansible_user: cloud-user
        ansible_become: true
        ansible_ssh_common_args: "-o StrictHostKeyChecking=no"
      children:
{% for group in inventory_groups %}
        {{ group }}:
          hosts:
{% for host in inventory_group_hosts[group] %}
            {{ host }}:
              ansible_host: {{ discovered_host_data[host].ansible_host }}
{% endfor %}
{% endfor %}
