---
# Platform and AAP bootstrap values. Copy to demo_variables.yml and edit.
demo_organization_name: RHEL GitOps
demo_state_project_name: rhel-gitops-state
demo_platform_project_name: rhel-gitops-platform
demo_inventory_name: RHEL Fleet
demo_ai_inventory_name: AI Control
demo_machine_credential_name: RHEL SSH Key
demo_state_scm_url: CHANGE_ME_GIT_REPO_URL
demo_state_scm_branch: main
demo_platform_scm_url: CHANGE_ME_PLATFORM_REPO_URL
demo_platform_scm_branch: main
aap_hostname: CHANGE_ME_AAP_URL
aap_validate_certs: false
openshift_api_url: CHANGE_ME
openshift_vm_namespace: CHANGE_ME
openshift_validate_certs: false
openshift_vm_datasource_name: rhel9
openshift_vm_datasource_namespace: openshift-virtualization-os-images
openshift_vm_storage_size: 30Gi
openshift_vm_multus_network_name: default/localnet-vlan150
demo_ssh_private_key_file: runtime/demo_key
demo_ssh_key_name: demo_key

# Red Hat registration values. Keep the activation key in vault.yml.
rhc_organization: "6340056"
rhc_repos_baseline:
  - name: rhel-9-for-x86_64-baseos-rpms
    state: enabled
  - name: rhel-9-for-x86_64-appstream-rpms
    state: enabled

# AI control VM model settings. The API key belongs in vault.yml.
demo_ai_llm_provider: openai
demo_ai_llm_model: gpt-5.6-luna
demo_ai_llm_base_url: https://api.openai.com/v1
demo_ai_repo_path: /home/cloud-user/agentic-aiops/state-repo
demo_ai_github_api_url: https://api.github.com
demo_ai_pr_branch_prefix: aiops/
# Select the event-processing backend. `automation_orchestrator` forwards EDA
# events to Automation Orchestrator; `crewai` keeps the VM-local fallback.
demo_ai_backend: automation_orchestrator
demo_ao_url: CHANGE_ME_AUTOMATION_ORCHESTRATOR_URL
demo_ao_username: admin
demo_ao_validate_certs: false
demo_ao_incident_eda_trigger_path: rhel-gitops-incident
demo_ao_pr_review_eda_trigger_path: rhel-gitops-pr-review
demo_ao_project_name: rhel-gitops-agentic-workflows
demo_ao_aap_integration_name: RHEL GitOps AAP
demo_ao_llm_integration_name: RHEL GitOps LLM
demo_ao_mcp_integration_name: RHEL GitOps Linux MCP
demo_ao_mcp_url: http://linux-mcp-server:8000/mcp
demo_ao_project_name: RHEL GitOps Agentic Workflows
# `container` uses the in-namespace OpenShift Service; set `local` to use the
# Linux MCP server installed on the AI VM over stdio instead.
demo_ai_mcp_mode: container
# In-namespace Streamable HTTP endpoint used by the container backend.
demo_ai_mcp_url: http://linux-mcp-server:8000/mcp
# Container image for the one-replica OpenShift MCP service.
demo_ai_mcp_container_image: quay.io/redhat-services-prod/rhel-lightspeed-tenant/linux-mcp-server:latest
demo_eda_project_name: RHEL GitOps EDA
demo_eda_controller_credential_name: EDA Controller Access
demo_eda_decision_environment_name: default-de
demo_eda_webhook_port: 5000
demo_eda_incident_label: ai-investigate
